{
  "name": "mistral-chat-web",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal chat UI that calls the Mistral API via the official TypeScript SDK. The API key stays on the server.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mistralai/mistralai": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
